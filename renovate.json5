{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  // Renovate runs before 3am on Monday, Chicago time.
  // One grouped PR per wave keeps review cost low.
  "schedule": ["before 3am on Monday"],
  "timezone": "America/Chicago",
  "labels": ["dependencies"],
  // Pin action refs to full SHA, not moving tags.
  "pinDigests": true,
  // No custom manager for README.
  // README has no version lines and no SHAs.
  // Renovate updates code SHA lines only.
  "packageRules": [
    {
      // Group GitHub Actions updates in one PR.
      "groupName": "GitHub Actions updates",
      "matchManagers": ["github-actions"]
    }
  ]
}
