{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  // Renovate runs before 3am on Monday, Chicago time.
  // One grouped PR per wave keeps review cost low.
  "schedule": ["before 3am on Monday"],
  "timezone": "America/Chicago",
  "labels": ["dependencies"],
  // Pin action refs to full SHA, not moving tags.
  "pinDigests": true,
  "packageRules": [
    {
      // Group GitHub Actions updates in one PR.
      "groupName": "GitHub Actions updates",
      "matchManagers": ["github-actions"]
    },
    {
      // Group README version updates with code updates.
      "groupName": "GitHub Actions updates",
      "matchDepNames": ["actions/checkout"]
    }
  ],
  // Custom manager updates README version lines.
  // It tracks upstream releases, not repo tags.
  // It cannot update README SHA lines or repo SHA.
  // Human updates those lines after tag creation.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "Upstream version is (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)",
        "This repo tag is (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "actions/checkout",
      "datasourceTemplate": "github-releases"
    }
  ]
}
