{"$schema":"https://docs.renovatebot.com/renovate-schema.json","customManagers":[{"customType":"regex","datasourceTemplate":"github-releases","depNameTemplate":"actions/checkout","managerFilePatterns":["/^README\\.md$/"],"matchStrings":["Upstream version is (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)","This repo tag is (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"]}],"extends":["config:best-practices"],"labels":["dependencies"],"packageRules":[{"groupName":"GitHub Actions updates","matchManagers":["github-actions"]},{"groupName":"GitHub Actions updates","matchDepNames":["actions/checkout"]}],"pinDigests":true,"schedule":["before 3am on Monday"]}